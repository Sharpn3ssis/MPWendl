# Zkopírujte tento soubor jako .env a vyplňte hodnoty

# Databáze MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=admin
DB_NAME=badatelsky_dejepis

# JWT - POVINNĚ změňte na produkci! (náhodný řetězec, min. 32 znaků)
JWT_SECRET=zmena_toto_na_nahodny_retezec_v_produkci

# CORS - URL frontendu oddělené čárkou
# Lokálně:
CORS_ORIGIN=http://localhost:5173
# Produkce (Vercel URL):
# CORS_ORIGIN=https://vas-projekt.vercel.app

# OpenAI (volitelné)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORGANIZATION=
